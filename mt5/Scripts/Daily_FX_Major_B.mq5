// Generated by build_scripts.py. Edit templates, then rebuild.
// Source: scanner cfg-0.13.0 / scalp-cfg-0.1.0. Signal-only; no order calls.
#property strict
#property script_show_inputs
#property version "1.00"
#property description "Daily_FX_Major_B: standalone scanner, closed bars only, no orders"
const string STRATEGY="Daily_FX_Major_B";
input string InpSymbol=""; // Empty = attached chart; use your broker's exact symbol
input bool InpAlert=true;
input double InpRuleTick=0.0; // Scalp distance override: 0 uses selected product profile; daily uses source feature tick
input bool InpNYCloseServer=true; // Source Forex.com model: server clock = New York + 7h (DST aware)
input int InpServerUTCOffsetMinutes=9999; // 9999 auto now; set explicitly for historical/offline data
input bool InpUseRealVolume=true; // VWAP falls back to tick volume, labelled in report
string sym;
double broker_tick,rule_tick;
int digits,report=INVALID_HANDLE,count=0,server_offset;
string report_name;
struct Frame
{
   MqlRates b[];
   double a[],r[],e9[],e15[],e30[],e65[],e200[];
   int k;
};
double RoundEven(double x)
{
   double base=MathFloor(x),frac=x-base;
   if(MathAbs(frac-0.5)<1e-10) return ((long)base%2==0 ? base : base+1);
   return MathRound(x);
}
double RT(double px) { return NormalizeDouble(RoundEven(px/broker_tick)*broker_tick,digits); }
string PX(double px) { return DoubleToString(RT(px),digits); }
bool Initialize()
{
   sym=InpSymbol=="" ? _Symbol : InpSymbol;
   if(!SymbolSelect(sym,true)) { Print("Cannot select ",sym); return false; }
   broker_tick=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE);
   digits=(int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
   if(broker_tick<=0 || InpRuleTick<0) { Print("Invalid tick size"); return false; }
   rule_tick=InpRuleTick>0 ? InpRuleTick : 0.10;
   server_offset=InpServerUTCOffsetMinutes==9999 ? (int)(MathRound((double)(TimeTradeServer()-TimeGMT())/1800)*30) : InpServerUTCOffsetMinutes;
   return true;
}
void EMA(MqlRates &b[],int period,double &out[])
{
   int n=ArraySize(b); ArrayResize(out,n); ArrayInitialize(out,EMPTY_VALUE);
   if(n<period) return;
   double total=0,alpha=2.0/(period+1);
   for(int i=0;i<period;i++) total+=b[i].close;
   out[period-1]=total/period;
   for(int i=period;i<n;i++) out[i]=alpha*b[i].close+(1-alpha)*out[i-1];
}
void ATR(MqlRates &b[],int period,double &out[])
{
   int n=ArraySize(b); ArrayResize(out,n); ArrayInitialize(out,EMPTY_VALUE);
   double total=0;
   for(int i=1;i<n;i++)
   {
      double tr=MathMax(b[i].high-b[i].low,MathMax(MathAbs(b[i].high-b[i-1].close),MathAbs(b[i].low-b[i-1].close)));
      if(i<=period) total+=tr;
      if(i==period) out[i]=total/period;
      if(i>period) out[i]=((period-1)*out[i-1]+tr)/period;
   }
}
void RSI(MqlRates &b[],int period,double &out[])
{
   int n=ArraySize(b); ArrayResize(out,n); ArrayInitialize(out,EMPTY_VALUE);
   double up=0,dn=0;
   for(int i=1;i<n;i++)
   {
      double d=b[i].close-b[i-1].close;
      if(i<=period) { up+=MathMax(d,0)/period; dn+=MathMax(-d,0)/period; }
      else { up=((period-1)*up+MathMax(d,0))/period; dn=((period-1)*dn+MathMax(-d,0))/period; }
      if(i>=period) out[i]=dn==0 ? 100 : 100-100/(1+up/dn);
   }
}
bool LoadFrame(ENUM_TIMEFRAMES tf,int requested,Frame &f)
{
   ArraySetAsSeries(f.b,false);
   int n=-1;
   for(int attempt=0;attempt<5 && !IsStopped();attempt++)
   {
      n=CopyRates(sym,tf,1,requested,f.b); // shift 1 excludes forming bar
      if(n>=requested) break;
      Sleep(200);
   }
   if(n<requested) { Print(sym," ",EnumToString(tf),": need ",requested," closed bars, got ",n,". Load history and rerun."); return false; }
   f.k=n-1;
   if(TimeCurrent()-f.b[f.k].time-PeriodSeconds(tf)>MathMax(900,PeriodSeconds(tf)))
      Print("WARNING: stale or closed-market data: ",EnumToString(tf));
   ATR(f.b,14,f.a); RSI(f.b,14,f.r);
   EMA(f.b,9,f.e9); EMA(f.b,15,f.e15); EMA(f.b,30,f.e30); EMA(f.b,65,f.e65); EMA(f.b,200,f.e200);
   return true;
}
double High(MqlRates &b[],int first,int last)
{
   double v=-DBL_MAX;
   for(int i=MathMax(0,first);i<=last;i++) v=MathMax(v,b[i].high);
   return v;
}
double Low(MqlRates &b[],int first,int last)
{
   double v=DBL_MAX;
   for(int i=MathMax(0,first);i<=last;i++) v=MathMin(v,b[i].low);
   return v;
}
bool OpenReport()
{
   string safe=sym;
   StringReplace(safe,"/","_"); StringReplace(safe,"\\","_"); StringReplace(safe,":","_");
   report_name=STRATEGY+"_"+safe+".csv";
   report=FileOpen(report_name,FILE_WRITE|FILE_CSV|FILE_ANSI,',');
   if(report==INVALID_HANDLE) { Print("Cannot open CSV: ",GetLastError()); return false; }
   FileWrite(report,"strategy","symbol","side","status","entry_type","entry","entry2","stop","tp1","tp2","risk_rule_ticks","risk_account_currency_per_lot","bar_server_time","note");
   return true;
}
void Emit(int side,string status,string order,double entry,double stop,double target1,double target2,datetime when,string note,double entry2=0)
{
   entry=RT(entry); stop=RT(stop);
   double risk_money=0;
   bool priced=OrderCalcProfit(side>0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,sym,1.0,entry,stop,risk_money);
   string money=priced ? DoubleToString(MathAbs(risk_money),2) : "unavailable";
   FileWrite(report,STRATEGY,sym,side>0 ? "long" : "short",status,order,PX(entry),entry2==0 ? "" : PX(entry2),PX(stop),PX(target1),target2==0 ? "" : PX(target2),DoubleToString(MathAbs(entry-stop)/rule_tick,1),money,TimeToString(when,TIME_DATE|TIME_MINUTES),note);
   string msg=STRATEGY+" "+sym+" "+(side>0 ? "LONG " : "SHORT ")+status+" entry "+PX(entry)+" stop "+PX(stop)+" TP "+PX(target1);
   Print(msg," ",note); count++;
   if(InpAlert && (status=="TRIGGERED" || status=="AT LEVEL" || status=="QUALIFIED")) Alert(msg);
}
void ScalpSignal(Frame &f,int side,string status,string order,double entry,double stop,double t1=10,double t2=0,string note="",double entry2=0,int bar=-1)
{
   // Targets are measured from the rounded entry, as in make_signal().
   entry=RT(entry);
   Emit(side,status,order,entry,stop,entry+side*t1*rule_tick,t2==0 ? 0 : entry+side*t2*rule_tick,f.b[bar<0 ? f.k : bar].time,note,entry2);
}
void FinishReport()
{
   FileClose(report);
   Print(STRATEGY,": ",count," signals; CSV in MQL5/Files/",report_name,". Signal scan only.");
}
datetime DSTBoundary(int year,int month,int hour,bool second)
{
   MqlDateTime d; ZeroMemory(d); d.year=year; d.mon=month; d.day=1; d.hour=hour;
   datetime base=StructToTime(d); TimeToStruct(base,d);
   return base+((7-d.day_of_week)%7+(second ? 7 : 0))*86400;
}
datetime UTC(datetime server)
{
   if(!InpNYCloseServer || InpServerUTCOffsetMinutes!=9999) return server-server_offset*60;
   datetime local=server-7*3600; MqlDateTime d; TimeToStruct(local,d);
   bool dst=local>=DSTBoundary(d.year,3,2,true) && local<DSTBoundary(d.year,11,2,false);
   return local+(dst ? 4 : 5)*3600;
}
datetime NYFromUTC(datetime utc)
{
   MqlDateTime d; TimeToStruct(utc,d);
   bool dst=utc>=DSTBoundary(d.year,3,7,true) && utc<DSTBoundary(d.year,11,6,false);
   return utc+(dst ? -4 : -5)*3600;
}
datetime NY(datetime server) { return NYFromUTC(UTC(server)); }
datetime ServerFromUTC(datetime utc)
{
   if(!InpNYCloseServer || InpServerUTCOffsetMinutes!=9999) return utc+server_offset*60;
   return NYFromUTC(utc)+7*3600;
}
long Session(datetime server) { return (long)(NY(server)-18*3600)/86400; }
// Position Trading Confluence System: technical C1-C6 only.
const string ASSET="fx_major";
const string EXPECTED_GRADE="B";
input string InpFXPair=""; // Canonical six-letter FX pair; needed when broker prefix obscures it
input double InpMajorSpacing=0; // 0 selects source grid for this asset
input double InpMidSpacing=0;
input double InpMajorHalfWidth=0;
input double InpMidHalfWidth=0;
input double InpPatternHalfWidth=0;
input double InpFeatureTick=0; // 0 source: FX .00001 / JPY .001 / gold .01 / SP .1 / oil .01
input bool InpShowDeveloping=true;
input bool InpFreezeDailyAtEvening=true; // Intraday/pre-NY cutoff at latest 00:05 UTC; false = evening scan
input int InpPivotWidth=2;
input int InpImpulseMaxAge=6;
input int InpImpulseMinSpan=3;
input int InpImpulseMaxSpan=30;
input double InpImpulseATR=2;
input double InpImpulseEfficiency=0.60;
struct Pivot { int k,kind,confirm; double price; };
struct Impulse { bool valid; double a,b,recognition_atr; };
double major,mid,major_hw,mid_hw,pattern_hw,feature_tick;
void AppendPivot(Pivot &seq[],Pivot &p)
{
   int n=ArraySize(seq);
   if(n>0 && seq[n-1].kind==p.kind)
   {
      if(p.kind*(p.price-seq[n-1].price)>0) seq[n-1]=p;
      return;
   }
   ArrayResize(seq,n+1); seq[n]=p;
}
void Pivots(MqlRates &b[],Pivot &raw[],bool alternate=true)
{
   ArrayResize(raw,0); int n=ArraySize(b),w=InpPivotWidth;
   for(int i=w;i<n-w;i++)
   {
      bool hi=true,lo=true;
      for(int j=i-w;j<=i+w;j++)
      {
         if(j==i) continue;
         if(b[i].high<=b[j].high) hi=false;
         if(b[i].low>=b[j].low) lo=false;
      }
      if(hi==lo) continue;
      Pivot p; p.k=i; p.confirm=i+w; p.kind=hi ? 1 : -1; p.price=hi ? b[i].high : b[i].low;
      if(alternate) AppendPivot(raw,p);
      else { int sz=ArraySize(raw); ArrayResize(raw,sz+1); raw[sz]=p; }
   }
}
int Structure(Pivot &seq[])
{
   double h0=0,h1=0,l0=0,l1=0; int hn=0,ln=0;
   for(int i=0;i<ArraySize(seq);i++)
   {
      if(seq[i].kind>0) { h0=h1; h1=seq[i].price; hn++; }
      else { l0=l1; l1=seq[i].price; ln++; }
   }
   if(hn<2 || ln<2) return 0;
   if(h1>h0 && l1>l0) return 1;
   if(h1<h0 && l1<l0) return -1;
   return 0;
}
int DailyBias(MqlRates &b[])
{
   Pivot raw[],seq[]; Pivots(b,raw,false);
   int bias=0,next=0; double inv=0;
   for(int i=0;i<ArraySize(b);i++)
   {
      if(bias!=0 && bias*(b[i].close-inv)<0) { bias=0; inv=0; }
      while(next<ArraySize(raw) && raw[next].confirm<=i) { AppendPivot(seq,raw[next]); next++; }
      double low=0,high=0; bool has_low=false,has_high=false;
      for(int j=0;j<ArraySize(seq);j++)
      {
         if(seq[j].kind<0) { low=seq[j].price; has_low=true; }
         else { high=seq[j].price; has_high=true; }
      }
      if(bias>0 && has_low && low>inv) inv=low;
      if(bias<0 && has_high && high<inv) inv=high;
      if(bias==0)
      {
         int s=Structure(seq);
         if(s>0 && has_low && b[i].close>=low) { bias=1; inv=low; }
         if(s<0 && has_high && b[i].close<=high) { bias=-1; inv=high; }
      }
   }
   return bias;
}
bool Holding(MqlRates &structure_bars[],Pivot &seq[],MqlRates &closes[],int side)
{
   int prev=-1,last=-1;
   for(int i=0;i<ArraySize(seq);i++) if(seq[i].kind==-side) { prev=last; last=i; }
   if(prev<0 || side*(seq[last].price-seq[prev].price)<=0) return false;
   for(int i=0;i<ArraySize(closes);i++)
      if(closes[i].time>=structure_bars[seq[last].k].time && side*(closes[i].close-seq[last].price)<0) return false;
   return true;
}
void SelectImpulse(Frame &f,Pivot &seq[],int side,Impulse &out)
{
   out.valid=false; int last_confirm=-1;
   for(int i=1;i<ArraySize(seq);i++)
   {
      Pivot a=seq[i-1],b=seq[i];
      if(a.kind!=-side || b.kind!=side || b.confirm<f.k-InpImpulseMaxAge+1) continue;
      int span=b.k-a.k;
      if(span<InpImpulseMinSpan || span>InpImpulseMaxSpan || f.a[b.k]==EMPTY_VALUE || f.a[b.k]<=0) continue;
      if(MathAbs(b.price-a.price)<InpImpulseATR*f.a[b.k]) continue;
      double path=0;
      for(int j=a.k+1;j<=b.k;j++) path+=MathAbs(f.b[j].close-f.b[j-1].close);
      if(path<=0 || MathAbs(f.b[b.k].close-f.b[a.k].close)/path<InpImpulseEfficiency) continue;
      int preceding=-1;
      for(int j=0;j<i-1;j++) if(seq[j].kind==side) preceding=j;
      if(preceding<0 || side*(b.price-seq[preceding].price)<=0) continue;
      bool voided=false;
      for(int j=b.k+1;j<=f.k;j++) if(side*(f.b[j].close-a.price)<0) voided=true;
      if(voided) continue;
      if(b.confirm>=last_confirm)
      {
         out.valid=true; out.a=a.price; out.b=b.price; out.recognition_atr=f.a[b.confirm]; last_confirm=b.confirm;
      }
   }
}
double Fib(Impulse &imp,double ratio) { return imp.b-ratio*(imp.b-imp.a); }
bool Zone(double price,double &level,double &hw)
{
   level=RoundEven(price/mid)*mid;
   bool is_major=MathAbs(level/major-RoundEven(level/major))<1e-9;
   hw=is_major ? major_hw : mid_hw;
   return MathAbs(price-level)<=hw+1e-12;
}
void Weekly(MqlRates &daily[],MqlRates &weekly[])
{
   ArrayResize(weekly,0); long prior=-1; bool friday=false;
   for(int i=0;i<ArraySize(daily);i++)
   {
      // Source groups normalized UTC daily labels into Monday-open weeks.
      // Match scanner weekly_from_daily(): use the UTC date of each native Daily open.
      MqlDateTime d; TimeToStruct(UTC(daily[i].time),d);
      int dow=d.day_of_week; d.hour=0; d.min=0; d.sec=0;
      long key=(long)(StructToTime(d)-((dow+6)%7)*86400);
      int n=ArraySize(weekly);
      if(key!=prior)
      {
         ArrayResize(weekly,n+1); weekly[n]=daily[i]; weekly[n].time=ServerFromUTC((datetime)key); prior=key; friday=false;
      }
      else
      {
         weekly[n-1].high=MathMax(weekly[n-1].high,daily[i].high);
         weekly[n-1].low=MathMin(weekly[n-1].low,daily[i].low);
         weekly[n-1].close=daily[i].close;
      }
      if(dow==5) friday=true;
   }
   if(!friday && ArraySize(weekly)>0) ArrayResize(weekly,ArraySize(weekly)-1);
}
bool PriorTrend(MqlRates &b[],int last,int side)
{
   return last>=6 && side*(b[last].close-b[last-6].close)<0;
}
string Pattern(MqlRates &b[],int t,double atr,int side,int &first)
{
   first=t;
   if(t>=2 && PriorTrend(b,t-2,side))
   {
      double body1=MathAbs(b[t-2].close-b[t-2].open),body2=MathAbs(b[t-1].close-b[t-1].open);
      if(side*(b[t-2].close-b[t-2].open)<0 && body1>=0.25*atr && body2<=0.3*body1 && side*(b[t].close-b[t].open)>0 && side*(b[t].close-(b[t-2].open+b[t-2].close)/2)>0)
      { first=t-2; return side>0 ? "morning star" : "evening star"; }
   }
   double body=MathAbs(b[t].close-b[t].open);
   if(t>=1)
   {
      bool engulf=side>0 ? (b[t].open<=b[t-1].close && b[t].close>=b[t-1].open) : (b[t].open>=b[t-1].close && b[t].close<=b[t-1].open);
      if(side*(b[t-1].close-b[t-1].open)<0 && side*(b[t].close-b[t].open)>0 && engulf && body>=0.25*atr)
         return side>0 ? "bullish engulfing" : "bearish engulfing";
      double extreme_diff=side>0 ? b[t].low-b[t-1].low : b[t].high-b[t-1].high;
      if(PriorTrend(b,t-1,side) && side*(b[t-1].close-b[t-1].open)<0 && side*(b[t].close-b[t].open)>0 && MathAbs(extreme_diff)<=0.05*atr)
      { first=t-1; return side>0 ? "tweezer bottom" : "tweezer top"; }
   }
   double range=b[t].high-b[t].low,lower=MathMin(b[t].open,b[t].close)-b[t].low,upper=b[t].high-MathMax(b[t].open,b[t].close);
   if(range>=0.5*atr && range>0 && PriorTrend(b,t-1,side))
   {
      if(lower>=2*body && upper<=0.25*range) return side>0 ? "hammer" : "hanging man";
      if(upper>=2*body && lower<=0.25*range) return side>0 ? "inverted hammer" : "shooting star";
   }
   return "";
}
bool Touch(MqlRates &b[],int first,int last,double low,double high)
{
   for(int i=first;i<=last;i++) if(b[i].low<=high && b[i].high>=low) return true;
   return false;
}
string Candle(Frame &f,int side,double low,double high)
{
   int t=f.k,first=t; double atr=f.a[t];
   string name=Pattern(f.b,t,atr,side,first);
   if(name!="" && Touch(f.b,first,t,low,high)) return name;
   double body=MathAbs(f.b[t].close-f.b[t].open),range=f.b[t].high-f.b[t].low;
   if(t>=2 && range>0 && body>=0.25*atr && side*(f.b[t].close-f.b[t].open)>0 && range-body<=0.1*range)
   {
      name=Pattern(f.b,t-1,f.a[t-1],side,first);
      if(name!="" && Touch(f.b,first,t-1,low,high)) return name+" + marubozu";
   }
   return "";
}
bool Neckline(MqlRates &b[],int start,int side,double worst,int neck_index,double neck_price,double slope)
{
   int t=ArraySize(b)-1,brk=-1;
   for(int i=start+1;i<=t;i++)
   {
      if(side*(b[i].close-worst)<0) return false;
      if(brk<0 && side*(b[i].close-neck_price-slope*(i-neck_index))>0) brk=i;
   }
   return brk>=0 && t-brk<3 && side*(b[t].close-neck_price-slope*(t-neck_index))>0;
}
bool AtZone(double p) { double level,hw; return Zone(p,level,hw); }
string Chart(Frame &f,Pivot &seq[],int side,bool daily)
{
   int indices[]; ArrayResize(indices,0);
   for(int i=0;i<ArraySize(seq);i++) if(seq[i].kind==-side) { int n=ArraySize(indices); ArrayResize(indices,n+1); indices[n]=i; }
   int n=ArraySize(indices); double tol=(daily ? 6.67 : 2.67)*pattern_hw,margin=(daily ? 3.33 : 1.33)*pattern_hw;
   if(n>=3)
   {
      Pivot s1=seq[indices[n-3]],head=seq[indices[n-2]],s2=seq[indices[n-1]],t1=seq[indices[n-2]-1],t2=seq[indices[n-1]-1];
      if(side*(s1.price-head.price)>0 && side*(s2.price-head.price)>0 && MathAbs(head.price-s1.price)>=margin && MathAbs(head.price-s2.price)>=margin && MathAbs(s1.price-s2.price)<=tol && s2.k-s1.k>=5 && AtZone(head.price) && t2.k>t1.k)
      {
         double slope=(t2.price-t1.price)/(t2.k-t1.k),worst=side>0 ? MathMin(head.price,MathMin(s1.price,s2.price)) : MathMax(head.price,MathMax(s1.price,s2.price));
         if(Neckline(f.b,s2.k,side,worst,t1.k,t1.price,slope)) return side>0 ? "inverse head and shoulders" : "head and shoulders";
      }
   }
   if(n>=2)
   {
      Pivot e1=seq[indices[n-2]],e2=seq[indices[n-1]],neck=seq[indices[n-1]-1];
      double worst=side>0 ? MathMin(e1.price,e2.price) : MathMax(e1.price,e2.price);
      if(MathAbs(e1.price-e2.price)<=tol && e2.k-e1.k>=5 && (AtZone(e1.price) || AtZone(e2.price)) && Neckline(f.b,e2.k,side,worst,neck.k,neck.price,0)) return side>0 ? "double bottom" : "double top";
   }
   return "";
}
bool ConfigureGrid()
{
   if(ASSET=="gold") { major=100; mid=50; major_hw=10; mid_hw=8; pattern_hw=20; feature_tick=0.01; }
   else if(ASSET=="spx") { major=100; mid=50; major_hw=20; mid_hw=20; pattern_hw=20; feature_tick=0.1; }
   else if(ASSET=="oil") { major=5; mid=2.5; major_hw=1; mid_hw=1; pattern_hw=1; feature_tick=0.01; }
   else
   {
      string pair=InpFXPair=="" ? sym : InpFXPair; StringToUpper(pair);
      string currencies[]={"USD","EUR","GBP","AUD","NZD","CAD","CHF","JPY"};
      string canonical="";
      for(int i=0;i<8;i++) for(int j=0;j<8;j++) if(i!=j && StringFind(pair,currencies[i]+currencies[j])>=0) canonical=currencies[i]+currencies[j];
      if(canonical=="") { Print("Set InpFXPair to the canonical six-letter currency pair"); return false; }
      bool usd=StringFind(canonical,"USD")>=0,jpy=StringSubstr(canonical,3,3)=="JPY";
      if((ASSET=="fx_major")!=usd) { Print("This script is for ",ASSET,"; selected pair ",canonical," belongs to a different strategy"); return false; }
      major=jpy ? 5 : 0.05; mid=jpy ? 2.5 : 0.025; major_hw=jpy ? 0.15 : 0.0015; mid_hw=major_hw; pattern_hw=major_hw; feature_tick=jpy ? 0.001 : 0.00001;
   }
   if(InpMajorSpacing>0) major=InpMajorSpacing;
   if(InpMidSpacing>0) mid=InpMidSpacing;
   if(InpMajorHalfWidth>0) major_hw=InpMajorHalfWidth;
   if(InpMidHalfWidth>0) mid_hw=InpMidHalfWidth;
   if(InpPatternHalfWidth>0) pattern_hw=InpPatternHalfWidth;
   if(InpFeatureTick>0) feature_tick=InpFeatureTick;
   rule_tick=feature_tick;
   return true;
}
void Indicators(Frame &f)
{
   f.k=ArraySize(f.b)-1; ATR(f.b,14,f.a); RSI(f.b,14,f.r);
   EMA(f.b,9,f.e9); EMA(f.b,15,f.e15); EMA(f.b,30,f.e30); EMA(f.b,65,f.e65); EMA(f.b,200,f.e200);
}
bool LoadDaily(Frame &f)
{
   Frame full; if(!LoadFrame(PERIOD_D1,1300,full)) return false;
   datetime cutoff=UTC(TimeCurrent());
   if(InpFreezeDailyAtEvening)
   {
      cutoff=(datetime)((long)cutoff/86400*86400)+300;
      if(cutoff>UTC(TimeCurrent())) cutoff-=86400;
   }
   int last=full.k;
   while(last>=0 && UTC(full.b[last].time)+86400>cutoff) last--;
   if(last<399) { Print("Need 400 completed Daily bars at cutoff"); return false; }
   ArrayResize(f.b,400);
   for(int i=0;i<400;i++) f.b[i]=full.b[last-399+i];
   Indicators(f); return true;
}
void Aggregate(MqlRates &hourly[],int seconds,Frame &f)
{
   ArrayResize(f.b,0); datetime previous=0;
   for(int i=0;i<ArraySize(hourly);i++)
   {
      datetime key=(datetime)((long)UTC(hourly[i].time)/seconds*seconds);
      if(key+seconds>UTC(TimeCurrent())) continue;
      int n=ArraySize(f.b);
      if(n==0 || key!=previous)
      {
         ArrayResize(f.b,n+1); f.b[n]=hourly[i]; f.b[n].time=ServerFromUTC(key); previous=key;
      }
      else
      {
         f.b[n-1].high=MathMax(f.b[n-1].high,hourly[i].high);
         f.b[n-1].low=MathMin(f.b[n-1].low,hourly[i].low);
         f.b[n-1].close=hourly[i].close;
      }
   }
   Indicators(f);
}
bool LoadIntraday(Frame &h4,Frame &h2)
{
   Frame hourly; if(!LoadFrame(PERIOD_H1,5000,hourly)) return false;
   Aggregate(hourly.b,14400,h4); Aggregate(hourly.b,7200,h2);
   if(h4.k<249 || h2.k<249) { Print("Need 250 completed UTC-aligned H4/H2 bars"); return false; }
   return true;
}
int OnStart()
{
   if(!Initialize() || !ConfigureGrid()) return 1;
   if(InpPivotWidth<1 || InpPivotWidth>30 || InpImpulseMaxAge<1 || InpImpulseMinSpan<1 || InpImpulseMaxSpan<InpImpulseMinSpan) { Print("Invalid structure parameters"); return 1; }
   Frame d,h4,h2;
   // Keep original 400-bar path-dependent Daily scoring window, not 1300 dynamics bars.
   if(!LoadDaily(d) || !LoadIntraday(h4,h2)) return 2;
   Pivot pd[],p4[],pw[]; Pivots(d.b,pd); Pivots(h4.b,p4);
   bool weekly_asset=ASSET=="gold" || ASSET=="spx" || ASSET=="oil";
   int bias=DailyBias(d.b),s4=Structure(p4),sw=0;
   if(weekly_asset) { MqlRates w[]; Weekly(d.b,w); Pivots(w,pw); sw=Structure(pw); }
   double fast[],slow[]; EMA(h2.b,8,fast); EMA(h2.b,14,slow);
   if(!OpenReport()) return 3;
   for(int side=1;side>=-1;side-=2)
   {
      bool c1=bias==side && (weekly_asset ? sw==side : s4==side);
      double price=h2.b[h2.k].close,level,hw; bool c2=Zone(price,level,hw);
      double zl=level-hw,zh=level+hw;
      Impulse imp; SelectImpulse(h4,p4,side,imp);
      double atr_rec=imp.valid ? imp.recognition_atr : h4.a[h4.k];
      double fib_hw=MathMax(2*feature_tick,0.10*atr_rec);
      bool c3=false,golden=false,stacked=false; double ratios[]={0.382,0.5,0.618};
      if(imp.valid) for(int i=0;i<3;i++)
      {
         double fib=Fib(imp,ratios[i]);
         if(MathAbs(price-fib)>fib_hw) continue;
         c3=true;
         if(i>0) { golden=true; if(c2 && fib>=zl && fib<=zh) stacked=true; }
      }
      string candle=Chart(d,pd,side,true); if(candle=="") candle=Candle(d,side,zl,zh);
      string tf="D1";
      if(candle=="") { tf="H4"; candle=Chart(h4,p4,side,false); if(candle=="") candle=Candle(h4,side,zl,zh); }
      if(candle=="") { tf="H2"; candle=Candle(h2,side,zl,zh); }
      bool c4=candle!="",c5=side*(fast[h2.k]-slow[h2.k])>0;
      bool c6=weekly_asset ? Holding(d.b,pd,d.b,side) : Holding(h4.b,p4,h2.b,side);
      int technical=(int)c1+(int)c2+(int)c3+(int)c4+(int)c5+(int)c6;
      bool extra=c4 || c5 || c6;
      bool a=c1 && c2 && golden && stacked && (ASSET=="gold" ? c4 : extra);
      bool b=ASSET=="gold" ? (c1 && c2 && c3) : (c1 && (c2 || golden) && extra);
      string grade="";
      if(ASSET=="fx_cross") { if(a && c4) grade="A"; }
      else if(a) grade="A";
      else if(b && ASSET!="spx" && ASSET!="oil") grade="B";
      bool qualified=grade==EXPECTED_GRADE;
      if(!qualified && (!InpShowDeveloping || technical<2 || grade!="")) continue;
      string flags=StringFormat("C1=%d C2=%d C3=%d C4=%d C5=%d C6=%d golden=%d stacked=%d",c1,c2,c3,c4,c5,c6,golden,stacked);
      string note=flags+"; zone "+PX(zl)+"-"+PX(zh)+"; C4 "+tf+" "+candle+"; technical only; news/COT/DXY/personality overlays unavailable";
      double entry=price,stop=0,tp1=0,tp2=0;
      if(imp.valid) { entry=Fib(imp,golden && MathAbs(price-Fib(imp,0.618))<MathAbs(price-Fib(imp,0.5)) ? 0.618 : 0.5); stop=Fib(imp,0.89); tp1=Fib(imp,-0.27); tp2=Fib(imp,-0.618); note+="; stop78.6="+PX(Fib(imp,0.786))+"; ladder="+PX(Fib(imp,0.382))+"/"+PX(Fib(imp,0.5))+"/"+PX(Fib(imp,0.618)); }
      if(imp.valid) Emit(side,qualified ? "QUALIFIED" : "DEVELOPING","Reference Fib plan",entry,stop,tp1,tp2,h2.b[h2.k].time,note);
      else
      {
         FileWrite(report,STRATEGY,sym,side>0 ? "long" : "short",qualified ? "QUALIFIED" : "DEVELOPING","No impulse: levels undefined",PX(price),"","","","","","",TimeToString(h2.b[h2.k].time,TIME_DATE|TIME_MINUTES),note);
         count++; Print(STRATEGY," ",sym," ",qualified ? "QUALIFIED" : "DEVELOPING","; no impulse, no invented stop/targets; ",note);
         if(qualified && InpAlert) Alert(STRATEGY+" "+sym+" qualified; plan requires owner-defined levels");
      }
   }
   FinishReport(); return 0;
}
