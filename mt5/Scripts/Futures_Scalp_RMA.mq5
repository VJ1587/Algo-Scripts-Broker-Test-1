// Generated by build_scripts.py. Edit templates, then rebuild.
// Source: scanner cfg-0.13.0 / scalp-cfg-0.1.0. Signal-only; no order calls.
#property strict
#property script_show_inputs
#property version "1.00"
#property description "Futures_Scalp_RMA: standalone scanner, closed bars only, no orders"
const string STRATEGY="Futures_Scalp_RMA";
input string InpSymbol=""; // Empty = attached chart; use your broker's exact symbol
input bool InpAlert=true;
input double InpRuleTick=0.0; // Scalp distance override: 0 uses selected product profile; daily uses source feature tick
input bool InpNYCloseServer=true; // Source Forex.com model: server clock = New York + 7h (DST aware)
input int InpServerUTCOffsetMinutes=9999; // 9999 auto now; set explicitly for historical/offline data
input bool InpUseRealVolume=true; // VWAP falls back to tick volume, labelled in report
string sym;
double broker_tick,rule_tick;
int digits,report=INVALID_HANDLE,count=0,server_offset;
string report_name;
struct Frame
{
   MqlRates b[];
   double a[],r[],e9[],e15[],e30[],e65[],e200[];
   int k;
};
double RoundEven(double x)
{
   double base=MathFloor(x),frac=x-base;
   if(MathAbs(frac-0.5)<1e-10) return ((long)base%2==0 ? base : base+1);
   return MathRound(x);
}
double RT(double px) { return NormalizeDouble(RoundEven(px/broker_tick)*broker_tick,digits); }
string PX(double px) { return DoubleToString(RT(px),digits); }
bool Initialize()
{
   sym=InpSymbol=="" ? _Symbol : InpSymbol;
   if(!SymbolSelect(sym,true)) { Print("Cannot select ",sym); return false; }
   broker_tick=SymbolInfoDouble(sym,SYMBOL_TRADE_TICK_SIZE);
   digits=(int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
   if(broker_tick<=0 || InpRuleTick<0) { Print("Invalid tick size"); return false; }
   rule_tick=InpRuleTick>0 ? InpRuleTick : 0.10;
   server_offset=InpServerUTCOffsetMinutes==9999 ? (int)(MathRound((double)(TimeTradeServer()-TimeGMT())/1800)*30) : InpServerUTCOffsetMinutes;
   return true;
}
void EMA(MqlRates &b[],int period,double &out[])
{
   int n=ArraySize(b); ArrayResize(out,n); ArrayInitialize(out,EMPTY_VALUE);
   if(n<period) return;
   double total=0,alpha=2.0/(period+1);
   for(int i=0;i<period;i++) total+=b[i].close;
   out[period-1]=total/period;
   for(int i=period;i<n;i++) out[i]=alpha*b[i].close+(1-alpha)*out[i-1];
}
void ATR(MqlRates &b[],int period,double &out[])
{
   int n=ArraySize(b); ArrayResize(out,n); ArrayInitialize(out,EMPTY_VALUE);
   double total=0;
   for(int i=1;i<n;i++)
   {
      double tr=MathMax(b[i].high-b[i].low,MathMax(MathAbs(b[i].high-b[i-1].close),MathAbs(b[i].low-b[i-1].close)));
      if(i<=period) total+=tr;
      if(i==period) out[i]=total/period;
      if(i>period) out[i]=((period-1)*out[i-1]+tr)/period;
   }
}
void RSI(MqlRates &b[],int period,double &out[])
{
   int n=ArraySize(b); ArrayResize(out,n); ArrayInitialize(out,EMPTY_VALUE);
   double up=0,dn=0;
   for(int i=1;i<n;i++)
   {
      double d=b[i].close-b[i-1].close;
      if(i<=period) { up+=MathMax(d,0)/period; dn+=MathMax(-d,0)/period; }
      else { up=((period-1)*up+MathMax(d,0))/period; dn=((period-1)*dn+MathMax(-d,0))/period; }
      if(i>=period) out[i]=dn==0 ? 100 : 100-100/(1+up/dn);
   }
}
bool LoadFrame(ENUM_TIMEFRAMES tf,int requested,Frame &f)
{
   ArraySetAsSeries(f.b,false);
   int n=-1;
   for(int attempt=0;attempt<5 && !IsStopped();attempt++)
   {
      n=CopyRates(sym,tf,1,requested,f.b); // shift 1 excludes forming bar
      if(n>=requested) break;
      Sleep(200);
   }
   if(n<requested) { Print(sym," ",EnumToString(tf),": need ",requested," closed bars, got ",n,". Load history and rerun."); return false; }
   f.k=n-1;
   if(TimeCurrent()-f.b[f.k].time-PeriodSeconds(tf)>MathMax(900,PeriodSeconds(tf)))
      Print("WARNING: stale or closed-market data: ",EnumToString(tf));
   ATR(f.b,14,f.a); RSI(f.b,14,f.r);
   EMA(f.b,9,f.e9); EMA(f.b,15,f.e15); EMA(f.b,30,f.e30); EMA(f.b,65,f.e65); EMA(f.b,200,f.e200);
   return true;
}
double High(MqlRates &b[],int first,int last)
{
   double v=-DBL_MAX;
   for(int i=MathMax(0,first);i<=last;i++) v=MathMax(v,b[i].high);
   return v;
}
double Low(MqlRates &b[],int first,int last)
{
   double v=DBL_MAX;
   for(int i=MathMax(0,first);i<=last;i++) v=MathMin(v,b[i].low);
   return v;
}
bool OpenReport()
{
   string safe=sym;
   StringReplace(safe,"/","_"); StringReplace(safe,"\\","_"); StringReplace(safe,":","_");
   report_name=STRATEGY+"_"+safe+".csv";
   report=FileOpen(report_name,FILE_WRITE|FILE_CSV|FILE_ANSI,',');
   if(report==INVALID_HANDLE) { Print("Cannot open CSV: ",GetLastError()); return false; }
   FileWrite(report,"strategy","symbol","side","status","entry_type","entry","entry2","stop","tp1","tp2","risk_rule_ticks","risk_account_currency_per_lot","bar_server_time","note");
   return true;
}
void Emit(int side,string status,string order,double entry,double stop,double target1,double target2,datetime when,string note,double entry2=0)
{
   entry=RT(entry); stop=RT(stop);
   double risk_money=0;
   bool priced=OrderCalcProfit(side>0 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,sym,1.0,entry,stop,risk_money);
   string money=priced ? DoubleToString(MathAbs(risk_money),2) : "unavailable";
   FileWrite(report,STRATEGY,sym,side>0 ? "long" : "short",status,order,PX(entry),entry2==0 ? "" : PX(entry2),PX(stop),PX(target1),target2==0 ? "" : PX(target2),DoubleToString(MathAbs(entry-stop)/rule_tick,1),money,TimeToString(when,TIME_DATE|TIME_MINUTES),note);
   string msg=STRATEGY+" "+sym+" "+(side>0 ? "LONG " : "SHORT ")+status+" entry "+PX(entry)+" stop "+PX(stop)+" TP "+PX(target1);
   Print(msg," ",note); count++;
   if(InpAlert && (status=="TRIGGERED" || status=="AT LEVEL" || status=="QUALIFIED")) Alert(msg);
}
void ScalpSignal(Frame &f,int side,string status,string order,double entry,double stop,double t1=10,double t2=0,string note="",double entry2=0,int bar=-1)
{
   // Targets are measured from the rounded entry, as in make_signal().
   entry=RT(entry);
   Emit(side,status,order,entry,stop,entry+side*t1*rule_tick,t2==0 ? 0 : entry+side*t2*rule_tick,f.b[bar<0 ? f.k : bar].time,note,entry2);
}
void FinishReport()
{
   FileClose(report);
   Print(STRATEGY,": ",count," signals; CSV in MQL5/Files/",report_name,". Signal scan only.");
}
datetime DSTBoundary(int year,int month,int hour,bool second)
{
   MqlDateTime d; ZeroMemory(d); d.year=year; d.mon=month; d.day=1; d.hour=hour;
   datetime base=StructToTime(d); TimeToStruct(base,d);
   return base+((7-d.day_of_week)%7+(second ? 7 : 0))*86400;
}
datetime UTC(datetime server)
{
   if(!InpNYCloseServer || InpServerUTCOffsetMinutes!=9999) return server-server_offset*60;
   datetime local=server-7*3600; MqlDateTime d; TimeToStruct(local,d);
   bool dst=local>=DSTBoundary(d.year,3,2,true) && local<DSTBoundary(d.year,11,2,false);
   return local+(dst ? 4 : 5)*3600;
}
datetime NYFromUTC(datetime utc)
{
   MqlDateTime d; TimeToStruct(utc,d);
   bool dst=utc>=DSTBoundary(d.year,3,7,true) && utc<DSTBoundary(d.year,11,6,false);
   return utc+(dst ? -4 : -5)*3600;
}
datetime NY(datetime server) { return NYFromUTC(UTC(server)); }
datetime ServerFromUTC(datetime utc)
{
   if(!InpNYCloseServer || InpServerUTCOffsetMinutes!=9999) return utc+server_offset*60;
   return NYFromUTC(utc)+7*3600;
}
long Session(datetime server) { return (long)(NY(server)-18*3600)/86400; }

enum FuturesProduct { PRODUCT_SELECT=0, PRODUCT_ES_MES=1, PRODUCT_NQ_MNQ=2, PRODUCT_CL_MCL=3, PRODUCT_GC_MGC=4 };
input FuturesProduct InpProduct=PRODUCT_SELECT; // REQUIRED: choose price-rule family for the attached symbol
// Micro contracts share parent price-distance rules; P&L uses the broker lot specification.
double Resolved(double override_value,double es,double nq,double cl,double gc)
{
   if(override_value<0) return 0; // negative disables an optional second target
   if(override_value>0) return override_value;
   if(InpProduct==PRODUCT_ES_MES) return es;
   if(InpProduct==PRODUCT_NQ_MNQ) return nq;
   if(InpProduct==PRODUCT_CL_MCL) return cl;
   return gc;
}
bool InitializeProfile()
{
   if(InpProduct==PRODUCT_SELECT) { Print("Select InpProduct: ES/MES, NQ/MNQ, CL/MCL or GC/MGC before scanning"); return false; }
   rule_tick=Resolved(InpRuleTick,0.25,0.25,0.01,0.1);
   Print(STRATEGY," product=",EnumToString(InpProduct)," rule tick=",DoubleToString(rule_tick,5)," broker tick=",DoubleToString(broker_tick,5));
   return rule_tick>0;
}
const bool NEEDS_M1=false;
input double InpMinimumExtensionTicks=0; // 0 uses selected product profile
input double InpExtensionATR=2.0;
input bool InpRequireBoth=false;
input int InpLookback=48;
input double InpClusterATR=0.25;
input double InpATRStop=1.0;
input double InpTargetTicks=0; // 0 uses selected product profile
input double InpTarget2Ticks=0; // 0 uses selected product profile // 0 profile default; -1 disables
void Scan(Frame &f,Frame &unused)
{
   int k=f.k;
   if(InpLookback<1 || InpLookback>k) { Print("Invalid RMA lookback"); return; }
   double levels[]; ArrayResize(levels,5);
   levels[0]=f.e30[k]; levels[1]=f.e65[k]; levels[2]=f.e200[k];
   int n=3; long current=Session(f.b[k].time),previous=-1;
   for(int i=k;i>=0;i--) if(Session(f.b[i].time)!=current) { previous=Session(f.b[i].time); break; }
   double ph=-DBL_MAX,pl=DBL_MAX,pc=0,pv=0,volume=0;
   bool ticks=false;
   for(int i=0;i<=k;i++)
   {
      long session=Session(f.b[i].time);
      if(session==previous) { ph=MathMax(ph,f.b[i].high); pl=MathMin(pl,f.b[i].low); pc=f.b[i].close; }
      if(session==current)
      {
         double v=InpUseRealVolume && f.b[i].real_volume>0 ? (double)f.b[i].real_volume : (double)f.b[i].tick_volume;
         if(!(InpUseRealVolume && f.b[i].real_volume>0)) ticks=true;
         pv+=(f.b[i].high+f.b[i].low+f.b[i].close)/3*v; volume+=v;
      }
   }
   if(previous>=0 && ph>-DBL_MAX) levels[n++]=(ph+pl+pc)/3;
   if(volume>0) levels[n++]=pv/volume;
   ArrayResize(levels,n); ArraySort(levels);
   double threshold=InpRequireBoth ? MathMax(Resolved(InpMinimumExtensionTicks,40,160,25,20)*rule_tick,InpExtensionATR*f.a[k]) : MathMin(Resolved(InpMinimumExtensionTicks,40,160,25,20)*rule_tick,InpExtensionATR*f.a[k]);
   for(int start=0;start<n;)
   {
      int end=start; double sum=levels[start];
      while(end+1<n && levels[end+1]-levels[end]<=InpClusterATR*f.a[k]) { end++; sum+=levels[end]; }
      double level=sum/(end-start+1); start=end+1;
      int side=f.b[k].close>level ? 1 : -1,j=k-1,lower=MathMax(0,k-InpLookback);
      while(j>=lower && (side>0 ? f.b[j].low>level : f.b[j].high<level)) j--;
      if(j<lower || j+1>=k) continue;
      double extension=side>0 ? High(f.b,j+1,k-1)-level : level-Low(f.b,j+1,k-1);
      if(extension<threshold) continue;
      bool touched=side>0 ? f.b[k].low<=level : f.b[k].high>=level;
      ScalpSignal(f,side,touched ? "AT LEVEL" : "ARMED","Limit",level,level-side*InpATRStop*f.a[k],Resolved(InpTargetTicks,8,40,10,10),Resolved(InpTarget2Ticks,12,0,0,0),"EMA30/65/200 + prior-session pivot + VWAP clusters; VWAP volume="+(ticks ? "tick proxy" : "real"));
   }
}

int OnStart()
{
   if(!Initialize() || !InitializeProfile()) return 1;
   Frame f5,f1;
   if(!LoadFrame(PERIOD_M5,1200,f5)) return 2;
   if(NEEDS_M1 && !LoadFrame(PERIOD_M1,600,f1)) return 2;
   if(!OpenReport()) return 3;
   Scan(f5,f1);
   FinishReport();
   return 0;
}
