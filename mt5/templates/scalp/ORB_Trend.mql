const bool NEEDS_M1=false;
input double InpExtensionTicks=20;
input double InpStopTicks=20;
input double InpTarget1Ticks=20;
input double InpTarget2Ticks=30;
void Scan(Frame &f,Frame &unused)
{
   datetime now=NY(TimeCurrent()); MqlDateTime d; TimeToStruct(now,d);
   int minutes=d.hour*60+d.min;
   if(minutes<575 || minutes>960) return;
   d.hour=0; d.min=0; d.sec=0; datetime day=StructToTime(d);
   if(now>day+960*60) return;
   datetime begin=day+570*60,end=day+(minutes>=585 ? 585 : 575)*60;
   double hi=-DBL_MAX,lo=DBL_MAX; int seen=0,last=-1,post=-1;
   for(int i=0;i<=f.k;i++)
   {
      datetime t=NY(f.b[i].time);
      if(t>=begin && t<end) { hi=MathMax(hi,f.b[i].high); lo=MathMin(lo,f.b[i].low); seen++; last=i; }
      if(t>=end && t<=now && post<0) post=i;
   }
   if(seen!=(int)((end-begin)/300) || last<0 || NY(f.b[last].time)+300!=end || post<0) return;
   int hit=-1,side=0;
   for(int i=post;i<=f.k;i++)
   {
      if(f.b[i].high>hi) { hit=i; side=1; break; }
      if(f.b[i].low<lo) { hit=i; side=-1; break; }
   }
   if(hit<0 || hit==f.k) return;
   double edge=side>0 ? hi : lo; int extended=-1;
   for(int i=hit;i<=f.k;i++)
   {
      double distance=side>0 ? f.b[i].high-edge : edge-f.b[i].low;
      if(distance>=InpExtensionTicks*rule_tick) { extended=i; break; }
   }
   if(extended<0) return;
   bool at=false;
   for(int i=extended+1;i<=f.k;i++)
   {
      bool touch=side>0 ? f.b[i].low<=edge : f.b[i].high>=edge;
      if(touch && i<f.k) return;
      if(i==f.k) at=touch;
   }
   double risk=MathMin(InpStopTicks*rule_tick,0.5*(hi-lo));
   ScalpSignal(f,side,at ? "AT LEVEL" : "ARMED","Limit",edge,edge-side*risk,InpTarget1Ticks,InpTarget2Ticks,"First return after ORB extension; NY RTH");
}
